  "info": {
    "title": "TrackOrder API",
    "description": "API REST de gestión y seguimiento de pedidos en tiempo real",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ActualizarUsuarioDto": {
        "type": "object",
        "properties": {
          "rol": {
            "type": "string",
            "enum": [
              "cliente",
              "vendedor",
              "repartidor",
              "admin"
            ]
          },
          "activo": {
            "type": "boolean"
          }
        }
      },
      "RegistroDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Ana López"
          },
          "email": {
            "type": "string",
            "example": "ana@correo.com"
          },
          "password": {
            "type": "string",
            "example": "Secreta123",
            "minLength": 8
          }
        },
        "required": [
          "nombre",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ana@correo.com"
          },
          "password": {
            "type": "string",
            "example": "Secreta123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CrearTiendaDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Panadería La Espiga"
          },
          "descripcion": {
            "type": "string",
            "example": "Pan artesanal y repostería"
          },
          "propietarioId": {
            "type": "string",
            "format": "uuid",
            "description": "Solo administrador: vendedor dueño de la tienda"
          }
        },
        "required": [
          "nombre"
        ]
      },
      "CrearProductoDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Concha de vainilla"
          },
          "descripcion": {
            "type": "string",
            "example": "Pieza individual"
          },
          "precio": {
            "type": "number",
            "example": 18.5
          },
          "imagenUrl": {
            "type": "string"
          }
        },
        "required": [
          "nombre",
          "precio"
        ]
      },
      "ActualizarProductoDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Concha de vainilla"
          },
          "descripcion": {
            "type": "string",
            "example": "Pieza individual"
          },
          "precio": {
            "type": "number",
            "example": 18.5
          },
          "imagenUrl": {
            "type": "string"
          },
          "disponible": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
