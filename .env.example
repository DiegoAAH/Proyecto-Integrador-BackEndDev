# Copia este archivo como .env y ajusta los valores.
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=trackorder
DB_PASSWORD=trackorder
DB_NAME=trackorder
# true solo en desarrollo: crea/actualiza las tablas a partir de las entidades.
DB_SYNC=true

# JWT
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=1h

# Administrador inicial (se crea al arrancar si no existe ningún administrador)
ADMIN_EMAIL=admin@trackorder.local
ADMIN_PASSWORD=Admin12345
