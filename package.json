{
  "name": "trackorder",
  "version": "1.0.0",
  "description": "TrackOrder: API de gestión y seguimiento de pedidos en tiempo real (monolito modular orientado a eventos)",
  "scripts": {
    "build": "babel src --out-dir dist --ignore \"src/**/*.spec.js\" --delete-dir-on-start",
    "start": "node -r @babel/register src/main.js",
    "start:dev": "node --watch -r @babel/register src/main.js",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "author": "Angel Barbarin, Diego Valerio, Diego Alvarez",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.1.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/register": "^7.28.3",
    "@nestjs/testing": "^12.1.3",
    "babel-jest": "^30.2.0",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "private": true,
  "jest": {
    "roots": ["<rootDir>/src"],
    "testRegex": ".*\\.spec\\.js$",
    "testEnvironment": "node"
  }
}
